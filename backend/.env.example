# Copy to backend/.env and adjust.

# Postgres from docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+psycopg://trackmymoney:trackmymoney@127.0.0.1:5433/trackmymoney
TEST_DATABASE_URL=postgresql+psycopg://trackmymoney:trackmymoney@127.0.0.1:5433/trackmymoney_test

# Optional server-side Jev key, used when the UI doesn't send its own.
# Leave empty to use keyword rules only unless the user enters a key in the UI.
# A Command Code API key works here (Studio > API keys): the Provider API serves Jev too.
JEV_API_KEY=

# Where Jev is reached. Empty: TypeSafe's own cloud (https://api.typesafe.ai).
# Command Code's Provider API: JEV_BASE_URL=https://api.commandcode.ai/provider and JEV_MODEL=typesafe/jev.
JEV_BASE_URL=
JEV_MODEL=

# Laya: the local model that categorises transactions (docker compose --profile laya up -d).
LAYA_BASE_URL=http://127.0.0.1:8100
LAYA_API_KEY=local-laya-key
# The fine-tuned checkpoint (see backend/training/README.md). Empty: the server's default.
LAYA_MODEL=laya-finance

# Comma-separated origins allowed to call the API when the frontend is hosted on another origin.
# Not needed locally: the Vite dev server proxies /api.
CORS_ORIGINS=
